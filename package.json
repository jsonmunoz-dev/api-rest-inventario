{
  "name": "api-rest-inventario",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de inventario documentada con OpenAPI/Swagger y lista para Docker",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "lint": "eslint .",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --testPathIgnorePatterns=integration --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
