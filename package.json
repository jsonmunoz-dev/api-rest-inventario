{
  "name": "api-rest-inventario",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de inventario documentada con OpenAPI/Swagger y lista para Docker",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "lint": "eslint .",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --testPathIgnorePatterns=integration --coverage"
  },
  "license": "MIT"
}
